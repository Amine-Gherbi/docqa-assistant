    {
      "question": "How does BERT compare with SBERT on semantic textual similarity?",
      "answer": {
        "claims": [
          {
            "text": "Directly using the output of BERT leads to rather poor performances.",
            "citations": [
              {
                "chunk_id": 301,
                "doc_id": "sentence-bert",
                "page_no": 4,
                "char_start": 2928,
                "char_end": 3019,
                "page_text_sha256": "0ff7b9383fab4920df557b4dfe0e8cf10c988fa7f171c1abd55291fc17df25fd",
                "quote": "The results shows that directly using the output of BERT leads to rather poor performances."
              }
            ]
          },
          {
            "text": "Averaged BERT embeddings and the CLS token are both worse than average GloVe embeddings.",
            "citations": [
              {
                "chunk_id": 302,
                "doc_id": "sentence-bert",
                "page_no": 4,
                "char_start": 3180,
                "char_end": 3235,
                "page_text_sha256": "0ff7b9383fab4920df557b4dfe0e8cf10c988fa7f171c1abd55291fc17df25fd",
                "quote": "Both are worse than computing average GloVe embeddings."
              }
            ]
          },
          {
            "text": "Training first on NLI and then on STSb gives a slight improvement of 1-2 points.",
            "citations": [
              {
                "chunk_id": 303,
                "doc_id": "sentence-bert",
                "page_no": 5,
                "char_start": 1328,
                "char_end": 1407,
                "page_text_sha256": "0859064455164728789e86344b6bd39d65f8031d0e38b0b5a68a334ae241b088",
                "quote": "We observe that the later strategy leads to a slight improvement of 1-2 points."
              }
            ]
          }
        ],
