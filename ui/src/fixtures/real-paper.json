    {
      "question": "How does SBERT derive and train sentence embeddings?",
      "answer": {
        "claims": [
          {
            "text": "SBERT adds a pooling operation to the output of BERT or RoBERTa to derive a fixed-size sentence embedding.",
            "citations": [
              {
                "chunk_id": 201,
                "doc_id": "sentence-bert",
                "page_no": 3,
                "char_start": 993,
                "char_end": 1055,
                "page_text_sha256": "25be865e69479d7c99a033fb339bef26fb8ce4b8fb6a64776f38e6e790afa1df",
                "quote": "SBERT adds a pooling operation to the output of BERT / RoBERTa"
              }
            ]
          },
          {
            "text": "Training updates the weights so that the produced sentence embeddings are semantically meaningful.",
            "citations": [
              {
                "chunk_id": 202,
                "doc_id": "sentence-bert",
                "page_no": 3,
                "char_start": 1447,
                "char_end": 1539,
                "page_text_sha256": "25be865e69479d7c99a033fb339bef26fb8ce4b8fb6a64776f38e6e790afa1df",
                "quote": "to update the weights such that the produced sentence embeddings are semantically meaningful"
              }
            ]
          },
          {
            "text": "The classification objective applies a softmax to u, v and their element-wise difference.",
            "citations": [
              {
                "chunk_id": 203,
                "doc_id": "sentence-bert",
                "page_no": 3,
                "char_start": 2127,
                "char_end": 2157,
                "page_text_sha256": "25be865e69479d7c99a033fb339bef26fb8ce4b8fb6a64776f38e6e790afa1df",
                "quote": "o = softmax(Wt(u, v, |u − v|))"
              }
            ]
          }
        ],
